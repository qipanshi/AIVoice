# Include INSIDE the existing HTTPS server{} for open.qipanshi.com.
# Host-native Nginx -> loopback service. Check these routes are unused first.
# The exact root route below serves the plugin guide. Other root paths remain unchanged.
location = / {
    proxy_pass http://127.0.0.1:18620;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
}
location ~ ^/install\.(ps1|sh)$ {
    proxy_pass http://127.0.0.1:18620;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
}
location = /mcp {
    proxy_pass http://127.0.0.1:18620;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 120s;
    client_max_body_size 64k;
    access_log off;
}
location ^~ /oauth/ {
    proxy_pass http://127.0.0.1:18620;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    access_log off;
}
location ^~ /aivoice/ {
    proxy_pass http://127.0.0.1:18620;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 30s;
    access_log off;
}
location ~ ^/\.well-known/(oauth-protected-resource(/mcp)?|oauth-authorization-server|openid-configuration)$ {
    proxy_pass http://127.0.0.1:18620;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
}
location ~ ^/(request|session/end(/(confirm|success))?)$ {
    proxy_pass http://127.0.0.1:18620;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    access_log off;
}
