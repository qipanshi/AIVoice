{
  "name": "aivoice-mcp",
  "version": "0.3.0",
  "description": "AIVoice MCP — authorized read-only access to Shengzhangmen meeting results",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/qipanshi/AIVoice.git" },
  "homepage": "https://github.com/qipanshi/AIVoice#readme",
  "bugs": { "url": "https://github.com/qipanshi/AIVoice/issues", "email": "friend_rrw@163.com" },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test:auth": "tsx --test tests/auth.test.ts",
    "test:store": "tsx --test tests/store.test.ts",
    "build:cli": "tsc -p cli/tsconfig.json",
    "test:cli": "tsx --test cli/tests/cli.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "jose": "6.1.3",
    "oidc-provider": "9.13.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/oidc-provider": "9.5.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
